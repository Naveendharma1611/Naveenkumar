# Copy to .env and fill in. Never commit .env.
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
# Optional separate key for signing JWTs (defaults to SECRET_KEY)
JWT_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (recommended). Leave unset to use SQLite for quick local development.
# DATABASE_URL=postgres://portfolio:password@localhost:5432/portfolio

# Frontend origin (CORS/CSRF + password reset links)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

MEDIA_URL=/media/
MAX_UPLOAD_SIZE_MB=50
ADMIN_URL=django-admin/

# Email (console backend prints reset emails to the terminal in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Cloud file storage (S3 / Cloudflare R2 / DigitalOcean Spaces)
USE_S3=false
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
